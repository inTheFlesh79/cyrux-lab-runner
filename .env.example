# Copy this file to .env and adjust it. Every variable is optional: the values shown
# (or described) are the defaults. Restart the runner after changing .env.
# Relative paths are relative to the root of the repository.

# Port and address the runner listens on
PORT=4000
HOST=0.0.0.0

# Where the runtime data is stored: lab zip cache (labs-cache/), extracted labs of each
# session (sessions/) and state files (state/).
# Default: ./data inside the repository.
# On the current VM, to keep using the existing folders: /home/yonaiker/lab-runner
# DATA_DIR=./data

# The platform's base compose file (the reverse proxy every lab gets).
# Default: ./base/base-proxy.yaml
# BASE_COMPOSE=./base/base-proxy.yaml

# Folder with the TLS certificate the labs' reverse proxy serves (labproxy.crt and labproxy.key).
# Default: ./certs inside the repository (git ignores it). Keep the private key out of git.
# On the current VM: /home/yonaiker/certs
# CERTS_DIR=./certs
